# Select one provider and model. If MODEL is omitted, graph.py picks Anthropic
# when ANTHROPIC_API_KEY exists, otherwise OpenAI when OPENAI_API_KEY exists.
PROVIDER=anthropic
MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_KEY=
# Or use PROVIDER=openai and MODEL=gpt-4o-mini with OPENAI_API_KEY.
OPENAI_API_KEY=
